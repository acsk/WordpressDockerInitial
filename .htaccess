
# Rota amigável para Testes WP Resgate
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^wp-admin/wp-resgate-system-tests/?$ wp-admin/admin.php?page=wp-resgate-system-tests [QSA,L]
</IfModule>

